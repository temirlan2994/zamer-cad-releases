{
  "name": "kepler-plan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kepler Plan — быстрый концепт-планировщик домов (чистый JS + canvas)",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "check": "npm run lint && npm test && npm run test:e2e",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
